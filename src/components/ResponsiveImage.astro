---
/**
 * Imagen optimizada por Astro: genera AVIF/WebP en varios anchos (sin ampliar el original).
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  class?: string;
  /** Solo para la imagen principal de la primera pantalla. */
  priority?: boolean;
}

const { src, alt, sizes, class: className, priority = false } = Astro.props;
const candidates = [360, 540, 720, 960, 1280, 1600, 1920];
const widths = [...candidates.filter((w) => w < src.width), src.width];
---

<Picture
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  formats={['avif', 'webp']}
  class={className}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding="async"
/>
