---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import Placeholder from './Placeholder.astro';
import SuiteFacts from './SuiteFacts.astro';
import Icon from './Icon.astro';
import ContactCard from './widgets/ContactCard.astro';
import AirbnbLinks from './widgets/AirbnbLinks.astro';
import { localeList, suiteIds, type Locale } from '../i18n/config';
import { pick, useTranslations } from '../i18n';
import { firstImage } from '../lib/images';
import { getSettings, getSuiteGuide } from '../lib/content';
import { guidePath, homePath } from '../lib/routes';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const settings = await getSettings();
const cover = firstImage('common/portada');
const suites = await Promise.all(suiteIds.map((id) => getSuiteGuide(lang, id)));
const alternates = Object.fromEntries(localeList.map((code) => [code, homePath(code)]));
---

<BaseLayout lang={lang} title={t('home.metaTitle')} description={t('home.metaDescription')} alternates={alternates} bodyClass="page-home">
  <SiteHeader lang={lang} alternates={alternates} overlay={Boolean(cover)} />

  <main id="main">
    <section class:list={['hero', { 'hero-has-image': cover }]}>
      {
        cover ? (
          <ResponsiveImage src={cover.src} alt={cover.label} sizes="100vw" class="hero-img" priority />
        ) : (
          <div class="hero-pattern" aria-hidden="true" />
        )
      }
      <div class="hero-content">
        <p class="eyebrow">{t('home.eyebrow')}</p>
        <h1 class="hero-title">{t('home.title')}</h1>
        <p class="hero-lead">{t('home.intro')}</p>
        <p class="hero-location">
          <Icon name="map-pin" size={16} />
          {settings.building.name} · {settings.building.area}
        </p>
      </div>
    </section>

    <section class="container suites" aria-labelledby="choose-title">
      <h2 id="choose-title" class="section-title">{t('home.choose')}</h2>
      <ul class="suite-grid">
        {
          suites.map(({ entry }) => {
            const s = entry.data;
            const image = s.cover ? { src: s.cover, label: s.coverAlt ?? s.name } : firstImage(`${s.suite}/portada`);
            const href = guidePath(lang, s.suite);
            return (
              <li class="suite-card">
                <a class="suite-card-link" href={href} aria-label={`${s.name} · ${t('home.open')}`}>
                  <div class="suite-card-media">
                    {image ? (
                      <ResponsiveImage src={image.src} alt="" sizes="(min-width: 860px) 420px, 100vw" class="suite-card-img" />
                    ) : (
                      <Placeholder title={s.name} caption={t('suite.photosSoon')} />
                    )}
                  </div>
                  <div class="suite-card-body">
                    <p class="eyebrow">{s.tagline}</p>
                    <h3 class="suite-card-title">{s.name}</h3>
                    <SuiteFacts
                      class="facts-compact"
                      items={[
                        { icon: 'building', label: t('suite.floor'), value: String(s.floor) },
                        { icon: 'users', label: t('suite.guests'), value: t('suite.upTo', { n: s.capacity }) },
                        ...(s.size ? [{ icon: 'grid' as const, label: 'm²', value: s.size.replace(/\s*m²$/, '') }] : []),
                      ]}
                    />
                    <span class="btn btn-primary suite-card-cta" aria-hidden="true">
                      {t('home.open')}
                      <Icon name="chevron-right" size={18} />
                    </span>
                  </div>
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>

    <section class="container home-extra">
      <a class="btn btn-ghost btn-block" href={settings.building.maps} target="_blank" rel="noopener noreferrer">
        <Icon name="map-pin" size={18} />
        {t('action.directions')} · {settings.building.name}
        <Icon name="arrow-up-right" size={14} />
      </a>
      <AirbnbLinks homeUrl={settings.airbnb.home} superhost={pick(settings.airbnb.superhost, lang)} t={t} />
      <div class="help-card">
        <h2 class="help-title">{t('home.help')}</h2>
        <p class="muted">{t('home.helpText')}</p>
        <ContactCard names={settings.hosts.names} phone={settings.hosts.phone} display={settings.hosts.display} t={t} />
      </div>
    </section>
  </main>

  <SiteFooter lang={lang} building={`${settings.building.name} · ${settings.building.area}`} />
</BaseLayout>
