---
import { useTranslations } from '../i18n';
import type { Locale } from '../i18n/config';

interface Props {
  lang: Locale;
  building: string;
}

const { lang, building } = Astro.props;
const t = useTranslations(lang);
---

<footer class="site-footer">
  <p class="footer-brand">{t('brand.name')}</p>
  <p class="footer-signature">{t('footer.signature')}</p>
  <p class="footer-meta">{building}</p>
</footer>
